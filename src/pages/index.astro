---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import PortScene from '../components/PortScene.astro';
import headshot from '../assets/headshot.jpeg';
import { getCollection } from 'astro:content';
import { agents, clients, email, ports, workedAt } from '../data/site';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 4);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', timeZone: 'UTC' });
---
<Base
  title="Lester Barahona, site reliability engineer"
  description="Senior SRE with more than 20 years in tech. Kubernetes platforms on AWS and Azure, and AI agents that take first response on the pager."
>
  <PortScene />

  <section class="section">
    <div class="wrap companies">
      <p><strong>Worked at</strong> {workedAt}.</p>
      <p><strong>Clients have included</strong> {clients}.</p>
    </div>
  </section>

  <section class="section" id="agents">
    <div class="wrap">
      <h2>The newest cargo: agents that do SRE work</h2>
      <p class="lede">These are working tools I use every day. They are read-only by default, they log their evidence, and they wait for my approval before anything changes.</p>
      <div class="rows" style="margin-top: 36px">
        {agents.map(([name, body]) => (
          <div>
            <span class="what"><strong>{name}</strong>{body}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="about">
    <div class="wrap about">
      <Image src={headshot} alt="Lester Barahona" width={300} height={400} class="portrait" />
      <div>
        <h2>Who's at the helm</h2>
        <p class="lede">I'm Lester. I started as a graphic designer, spent eight years writing web applications, and have kept production running for the twelve years since. I work from San Pedro Sula, Honduras, in English and Spanish.</p>
        <p class="lede" style="margin-top: 16px">Today I'm a senior systems engineer at Fueled, and I'm open to senior or staff SRE and platform roles, or contract work.</p>
      </div>
    </div>
  </section>

  <section class="section" id="experience">
    <div class="wrap">
      <h2>Ports of call</h2>
      <div class="rows">
        {ports.map(([when, role, body]) => (
          <div>
            <span class="when">{when}</span>
            <span class="what"><strong>{role}</strong>{body}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="writing">
    <div class="wrap">
      <h2>Ship's log</h2>
      <div class="posts">
        {posts.map((post) => (
          <a href={`/${post.id}/`}><span>{post.data.title}</span><span>{fmt(post.data.date)}</span></a>
        ))}
      </div>
    </div>
  </section>

  <section class="contact" id="contact">
    <div class="wrap contact-grid">
      <div>
        <h2>Need a hand on deck?</h2>
        <p>I'm open to senior and staff SRE or platform roles, and to contract work. I reply within one business day.</p>
        <p>Prefer email? <a href={`mailto:${email}`}>{email}</a></p>
      </div>
      <form class="contact-form" action="/api/contact" method="post">
        <label for="cf-name">Your name</label>
        <input id="cf-name" name="name" type="text" autocomplete="name" required maxlength="120" />
        <label for="cf-email">Your email</label>
        <input id="cf-email" name="email" type="email" autocomplete="email" required maxlength="200" />
        <label for="cf-message">What do you need?</label>
        <textarea id="cf-message" name="message" rows="6" required maxlength="5000"></textarea>
        <div class="hp" aria-hidden="true">
          <label for="cf-company">Company (leave this empty)</label>
          <input id="cf-company" name="company" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <button class="btn coral" type="submit">Send message</button>
        <p class="form-status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>

  <script>
    const form = document.querySelector<HTMLFormElement>('.contact-form');
    const status = form?.querySelector<HTMLElement>('.form-status');
    const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (form && status && button) {
      // Outcome of a plain (no-JavaScript-path) form post, passed back in the address.
      const outcome = new URLSearchParams(location.search).get('contact');
      if (outcome === 'sent') status.textContent = 'Sent. I reply within one business day.';
      if (outcome === 'error') status.textContent = 'The message could not be sent. Check the fields and try again.';

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        button.disabled = true;
        button.textContent = 'Sending';
        status.textContent = '';
        try {
          const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { accept: 'application/json' } });
          const data = (await res.json()) as { ok: boolean; message: string };
          status.textContent = data.message;
          if (data.ok) form.reset();
        } catch {
          status.textContent = 'The message could not be sent. Check your connection and try again.';
        }
        button.disabled = false;
        button.textContent = 'Send message';
      });
    }
  </script>
</Base>
