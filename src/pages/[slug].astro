---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';

// Posts keep their WordPress addresses: /<slug>/ at the site root.
export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const words = (post.body ?? '').split(/\s+/).length;
const minutes = Math.max(1, Math.round(words / 200));
const date = post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<Base title={`${post.data.title} | Lester Barahona`} description={post.data.description}>
  <article class="post">
    <header>
      <p class="meta"><a href="/blog/">Ship's log</a>, {date}, {minutes} minute read</p>
      <h1>{post.data.title}</h1>
    </header>
    <div class="prose">
      <Content />
    </div>
    <footer>
      <p>Written by Lester Barahona. Hiring, or need a hand? <a href="/#contact">Get in touch</a>.</p>
    </footer>
  </article>
</Base>

<style is:global>
  .post { max-width: 46rem; margin: 0 auto; padding: 140px clamp(20px, 5vw, 40px) 96px; }
  .post header h1 { font-size: clamp(2.125rem, 5vw, 3.5rem); line-height: 1.06; margin-top: 12px; }
  .post .meta { font-weight: 700; font-size: 1rem; }
  .post footer { margin-top: 64px; padding-top: 24px; border-top: 2px solid var(--ink); }
  .prose { margin-top: 40px; font-size: 1.1875rem; line-height: 1.7; }
  .prose > * + * { margin-top: 1.2em; }
  .prose h2 { font-size: 1.875rem; line-height: 1.15; margin-top: 2.2em; scroll-margin-top: 80px; }
  .prose h3 { font-size: 1.375rem; line-height: 1.2; margin-top: 1.8em; scroll-margin-top: 80px; }
  .prose img { max-width: 100%; height: auto; display: block; }
  .prose a { color: #0a5f68; }
  .prose a:hover { color: var(--ink); }
  .prose ul, .prose ol { padding-left: 1.3em; }
  .prose li + li { margin-top: 0.4em; }
  .prose blockquote { margin: 1.4em 0; padding: 4px 0 4px 20px; border: 2px solid var(--sea); border-width: 0 0 0 0; background: none; font-size: 1.3125rem; font-family: var(--display); font-weight: 600; }
  .prose pre { overflow-x: auto; padding: 18px 20px; font-size: 0.9375rem; line-height: 1.55; border: 2px solid var(--ink); }
  .prose code { font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace; font-size: 0.92em; }
  .prose :not(pre) > code { background: var(--sky); padding: 0.1em 0.35em; }
  .prose table { display: block; overflow-x: auto; border-collapse: collapse; font-size: 1rem; }
  .prose th, .prose td { border: 1px solid var(--ink); padding: 8px 12px; text-align: left; }
  .prose hr { border: 0; border-top: 2px solid var(--ink); margin: 2.4em 0; }
</style>
