---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', timeZone: 'UTC' });
---
<Base title="Ship's log | Lester Barahona" description="Write-ups on SRE, Kubernetes, migrations and AI agents for operations, by Lester Barahona.">
  <section class="section" style="padding-top: 140px; padding-bottom: 96px">
    <div class="wrap">
      <h1 style="font-size: clamp(2.5rem, 6vw, 4.5rem); line-height: 1; margin-bottom: 16px">Ship's log</h1>
      <p class="lede" style="margin-bottom: 40px">Write-ups from real migrations, incidents and experiments.</p>
      <div class="posts">
        {posts.map((post) => (
          <a href={`/${post.id}/`}>
            <span>{post.data.title}</span>
            <span>{fmt(post.data.date)}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
