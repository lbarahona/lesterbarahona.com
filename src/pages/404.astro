---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | Lester Barahona" description="This page does not exist.">
  <section class="section" style="padding-top: clamp(104px, 18vw, 160px); padding-bottom: 120px">
    <div class="wrap">
      <h1 style="font-size: clamp(2.5rem, 6vw, 4.5rem); line-height: 1; margin-bottom: 16px">This page has sailed.</h1>
      <p class="lede" style="margin-bottom: 28px">The address is wrong or the page has moved. The homepage and the writing index are both still at the dock.</p>
      <p style="display: flex; flex-wrap: wrap; gap: 12px">
        <a class="btn" href="/">Go to the homepage</a>
        <a class="btn ghost" href="/blog/">Read the writing</a>
      </p>
    </div>
  </section>
</Base>
