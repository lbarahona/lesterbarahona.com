---
import { getImage } from 'astro:assets';
import { cargo, email } from '../data/site';
import bgFile from '../assets/port/background.jpg';
import shipFile from '../assets/port/ship.png';
import craneFile from '../assets/port/crane.png';
import c1 from '../assets/port/container-1.png';
import c2 from '../assets/port/container-2.png';
import c3 from '../assets/port/container-3.png';
import c4 from '../assets/port/container-4.png';
import c5 from '../assets/port/container-5.png';

const bg = await getImage({ src: bgFile, width: 2400, format: 'webp', quality: 78 });
const ship = await getImage({ src: shipFile, width: 1400, format: 'webp', quality: 82 });
const crane = await getImage({ src: craneFile, width: 1200, format: 'webp', quality: 82 });
const containers = await Promise.all(
  [c1, c2, c3, c4, c5].map((src) => getImage({ src, width: 300, format: 'webp', quality: 82 })),
);
const START = 0.14;
const STEP = 0.14;
---
<section class="stage" data-stage aria-label="What I do">
  <div class="scene">
    <svg viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <defs>
        <clipPath id="water">
          <path d="M0 800 q40 -10 80 0 t80 0 t80 0 t80 0 t80 0 t80 0 t80 0 t80 0 t80 0 t80 0 t80 0 t80 0 t80 0 t80 0 t80 0 t80 0 t80 0 t80 0 t80 0 t80 0 V900 H0 Z" />
        </clipPath>
      </defs>
      <image href={bg.src} width="1600" height="900" preserveAspectRatio="xMidYMid slice" />
      <g class="crane-fit">
        <image href={crane.src} x="720" y="166" width="760" height="569" />
      </g>
      <g class="ship-fit">
        <g class="ship">
          {cargo.map((c, i) => (
            <g class="cont" style={`--s:${(START + i * STEP).toFixed(2)}`}>
              <image href={containers[i].src} x={c.x} y={c.y} width="100" height="54" />
              <text x={c.x + 50} y={c.y + 32} text-anchor="middle" font-size="14" font-weight="800" fill={c.text}>{c.label}</text>
            </g>
          ))}
          <image href={ship.src} x="420" y="569" width="620" height="251" />
        </g>
      </g>
      <image class="foam" href={bg.src} width="1600" height="900" preserveAspectRatio="xMidYMid slice" clip-path="url(#water)" />
    </svg>

    <div class="panel hero" data-s="-1" data-e="0.10" style="--s:-1;--e:0.10">
      <p class="who">Site reliability engineer</p>
      <h1>I ship production, and I keep it afloat.</h1>
      <p>More than 20 years in tech. I build Kubernetes platforms, and the AI agents that help run them. Scroll to load the ship.</p>
      <div class="cta">
        <a class="btn" href={`mailto:${email}`}>Email me</a>
        <a class="btn ghost" href="/cv/">Read my CV</a>
      </div>
    </div>

    {cargo.map((c, i) => {
      const s = START + i * STEP;
      const e = s + STEP - 0.02;
      return (
        <div class="panel" data-s={s.toFixed(2)} data-e={e.toFixed(2)} style={`--s:${s.toFixed(2)};--e:${e.toFixed(2)}`}>
          <h2>{c.title}</h2>
          <p>{c.body}</p>
          <span class="count">Container {i + 1} of {cargo.length}</span>
        </div>
      );
    })}

    <div class="panel" data-s="0.86" data-e="2" style="--s:0.86;--e:2">
      <h2>Loaded. Ready to sail.</h2>
      <p>That's the cargo. The rest of the page is how it works and where it has been.</p>
    </div>
  </div>
</section>

<style>
  .stage { position: relative; height: 640vh; --p: 0; }
  .scene { position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden; background: #8fc7dc; }
  .scene > svg { position: absolute; inset: 0; width: 100%; height: 100%; font-family: var(--display); }
  .panel {
    position: absolute;
    left: var(--gutter);
    top: clamp(84px, 13vh, 150px);
    max-width: min(560px, calc(100vw - 2 * var(--gutter)));
    padding: 20px 24px;
    margin: -20px -24px;
    background: color-mix(in srgb, #f4fbfc 90%, transparent);
    --a: clamp(0, calc((var(--p) - var(--s)) / 0.03), 1);
    --b: clamp(0, calc((var(--p) - var(--e)) / 0.03), 1);
    opacity: calc(min(var(--a), 1 - var(--b)));
    transform: translateY(calc((1 - var(--a)) * 24px - var(--b) * 24px));
  }
  .panel[inert] { pointer-events: none; }
  .panel h1 { font-size: clamp(2.5rem, 6vw, 5.25rem); line-height: 1; margin-bottom: 16px; }
  .panel h2 { font-size: clamp(2rem, 4.4vw, 3.75rem); line-height: 1.02; margin-bottom: 12px; }
  .panel p { font-size: clamp(1.125rem, 1.6vw, 1.375rem); max-width: 30em; }
  .who { font-family: var(--display); font-weight: 700; margin-bottom: 10px; }
  .cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 22px; }
  .count { display: inline-block; margin-top: 14px; font-family: var(--display); font-weight: 700; background: var(--ink); color: var(--paper); padding: 4px 12px; }

  .ship {
    --in: clamp(0, calc(var(--p) / 0.12), 1);
    transform: translate(calc((var(--in) - 1) * (var(--in) - 1) * -1150px), calc(sin(var(--p) * 60) * 4px));
  }
  .cont {
    --t: clamp(0, calc((var(--p) - var(--s)) / 0.09), 1);
    opacity: min(1, calc(var(--t) * 4));
    transform: translateY(calc((1 - var(--t)) * (1 - var(--t)) * -300px));
  }
  .cont text { font-family: var(--display); }
  .ship-fit { transform-origin: 730px 820px; transform: scale(1.18); }

  /* Tall, narrow screens: the slice shows only the middle of the scene, so pull the ship and crane into it. */
  @media (max-aspect-ratio: 4/5) {
    .ship-fit { transform-origin: 730px 820px; transform: translate(70px, 0) scale(0.6); }
    .crane-fit { transform-origin: 1385px 735px; transform: translate(-360px, 0) scale(0.75); }
    .panel { top: 112px; }
  }
  @media (min-aspect-ratio: 4/5) and (max-aspect-ratio: 5/4) {
    .ship-fit { transform-origin: 730px 820px; transform: translate(40px, 0) scale(0.8); }
    .crane-fit { transform-origin: 1385px 735px; transform: translate(-180px, 0) scale(0.9); }
  }

  /* No motion: show the loaded ship once and list the cargo as plain text. */
  @media (prefers-reduced-motion: reduce) {
    .stage { height: auto; --p: 0.8 !important; }
    .scene { position: relative; height: auto; overflow: visible; padding: 96px var(--gutter) 48px; display: grid; gap: 40px; }
    .scene > svg { position: relative; inset: auto; height: 46vh; order: 2; }
    .panel { position: static; opacity: 1; transform: none; margin: 0; padding: 0; background: none; max-width: 40em; }
  }
</style>

<noscript>
  <style>
    .stage { height: auto !important; --p: 0.8 !important; }
    .scene { position: relative !important; height: auto !important; overflow: visible !important; padding: 96px var(--gutter) 48px; display: grid; gap: 40px; }
    .scene > svg { position: relative !important; inset: auto !important; height: 46vh !important; order: 2; }
    .panel { position: static !important; opacity: 1 !important; transform: none !important; margin: 0 !important; padding: 0 !important; background: none !important; }
  </style>
</noscript>

<script>
  const stage = document.querySelector<HTMLElement>('[data-stage]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  if (stage) {
    const panels = [...stage.querySelectorAll<HTMLElement>('.panel')];
    let queued = false;
    const update = () => {
      queued = false;
      if (reduce.matches) {
        stage.style.removeProperty('--p');
        panels.forEach((el) => (el.inert = false));
        return;
      }
      const r = stage.getBoundingClientRect();
      const total = r.height - innerHeight;
      const p = total > 0 ? Math.min(1, Math.max(0, -r.top / total)) : 0;
      stage.style.setProperty('--p', p.toFixed(4));
      for (const el of panels) {
        const s = Number(el.dataset.s);
        const e = Number(el.dataset.e);
        el.inert = p < s || p > e + 0.03;
      }
    };
    const request = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(update);
      }
    };
    addEventListener('scroll', request, { passive: true });
    addEventListener('resize', request);
    reduce.addEventListener('change', request);
    update();
  }
</script>
