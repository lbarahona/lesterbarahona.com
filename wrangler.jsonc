{
  // Production Worker for lesterbarahona.com. Serves the static Astro build from
  // ./dist and handles the contact form at /api/contact.
  // The custom domains are attached in the Cloudflare dashboard, not here, so a
  // deploy can never move DNS on its own.
  "name": "lesterbarahona-com",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Contact-form mail can only go to this one verified address.
  "send_email": [
    { "name": "EMAIL", "destination_address": "lestermiller26@gmail.com" }
  ],
  "env": {
    // Preview Worker: every branch other than main deploys here.
    "preview": {
      "name": "lesterbarahona-preview",
      "send_email": [
        { "name": "EMAIL", "destination_address": "lestermiller26@gmail.com" }
      ]
    }
  }
}
